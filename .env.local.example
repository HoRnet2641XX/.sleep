# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Affiliate links
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=nemuri02-22
# 楽天アフィリエイトで発行された hb.afl.rakuten.co.jp/ichiba/<この部分>/ のID
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=your-rakuten-hgc-id
# 任意: 楽天の生成URLをテンプレートで使う場合。{encodedUrl} が楽天市場検索URLに置換されます。
NEXT_PUBLIC_RAKUTEN_AFFILIATE_URL_TEMPLATE=

# Analytics
# 任意: Google Analytics 4 の測定ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# 任意: Plausible Analytics のドメイン
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# 任意: true の時だけブラウザ console にイベント送信内容を出します
NEXT_PUBLIC_ANALYTICS_DEBUG=false
